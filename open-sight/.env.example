# OpenSight Private - Production Environment Configuration
# Copy this file to .env and customize for your deployment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql+psycopg://opensight:STRONG_PASSWORD_HERE@localhost:5432/opensight

# =============================================================================
# SECURITY SETTINGS (CRITICAL - CHANGE IN PRODUCTION)
# =============================================================================
# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-secret-key-min-32-characters-long

# API Key header name
API_KEY_HEADER=X-API-Key

# Disable anonymous access in production
ALLOW_ANONYMOUS=false

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# =============================================================================
# VIDEO PROCESSING SETTINGS
# =============================================================================
# Maximum concurrent camera streams (1-64)
MAX_CONCURRENT_CAMERAS=16

# Target frames per second for processing (1.0-30.0)
PROCESSING_FPS_TARGET=5.0

# Number of frames to skip between processing (0-10)
SKIP_FRAMES=2

# Confidence threshold for detections (0.0-1.0)
CONFIDENCE_THRESHOLD=0.35

# IoU threshold for non-maximum suppression (0.0-1.0)
IOU_THRESHOLD=0.45

# Device for model inference: cpu, cuda, mps
MODEL_DEVICE=cpu

# YOLO model path or ultralytics identifier
MODEL_PATH=yolov8n.pt

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# Root directory for media storage
MEDIA_ROOT=./data/media

# Root directory for video clips
CLIPS_ROOT=./data/clips

# Root directory for thumbnails
THUMBNAILS_ROOT=./data/thumbnails

# Default retention period for media files (1-365 days)
DEFAULT_RETENTION_DAYS=14

# Maximum duration for saved video clips (10-300 seconds)
MAX_CLIP_DURATION_SECONDS=60

# Frame buffer size for clip generation (10-100)
FRAME_BUFFER_SIZE=30

# =============================================================================
# RTSP CONNECTION SETTINGS
# =============================================================================
# RTSP connection timeout in seconds (5-60)
RTSP_TIMEOUT_SECONDS=10

# Delay between reconnection attempts (1.0-60.0)
RECONNECT_DELAY_SECONDS=5.0

# =============================================================================
# PERFORMANCE & RESOURCE MANAGEMENT
# =============================================================================
# Database connection pool size (5-50)
DB_POOL_SIZE=10

# Database connection pool overflow (0-50)
DB_MAX_OVERFLOW=20

# Worker thread pool size (None for auto, 1-32)
WORKER_THREAD_POOL_SIZE=

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format string
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - [%(filename)s:%(lineno)d] - %(message)s

# Enable Prometheus-style metrics endpoint
ENABLE_METRICS=false

# Enable audit trail for sensitive operations
ENABLE_AUDIT_LOGGING=true

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Debug mode (disable in production)
DEBUG=false

# Host to bind the API server
HOST=0.0.0.0

# Port to bind the API server (1-65535)
PORT=8000

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=production
